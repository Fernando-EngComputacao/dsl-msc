# Configuracao do LLM do SPC-CML. Copie para `.env` (que NAO e versionado) e preencha.
# Lida por src/inference/motor-llm.ts; o ambiente do shell prevalece sobre o arquivo.
# O endpoint do motor local continua em SPC_CML_ENDPOINT (e _AGRO / _FUT), no ambiente.

# Backend: llamacpp (padrao: motor local src/python_engine) | openai | gemini.
# openai e gemini ja sao validados, mas o adaptador deles e da Etapa 2.
LLM_BACKEND=llamacpp
# No llamacpp e so informativo: o modelo e o que o motor carregou
# (SPC_CML_GGUF_REPO / SPC_CML_GGUF_FILE). Nos outros, vale se *_MODEL estiver vazio.
LLM_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

# Reparo semantico: realimentar o LLM com as falhas do validador (Etapa 2).
SPC_CML_SEMANTIC_REPAIR=true
SPC_CML_MAX_RETRIES=3
